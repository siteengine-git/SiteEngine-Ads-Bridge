{
  "manifest_version": 2,
  "name": "Alma joint fixture tab control — reviewed temporary tool",
  "version": "1.0.0",
  "browser_specific_settings": {"gecko": {"id": "alma-joint-fixture@siteengine.invalid", "strict_min_version": "115.0"}},
  "permissions": ["webRequest", "webRequestBlocking", "tabs", "<all_urls>"],
  "background": {"scripts": ["joint-firefox-core.js", "background.js"], "persistent": true},
  "browser_action": {"default_title": "Alma fixture control", "default_popup": "popup.html"}
}
